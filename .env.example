# PostgreSQL (URL-encode special characters in the password)
DATABASE_URL=postgresql+psycopg2://job_find_me_user:change_me@localhost:5432/job_find_me

# Public-web discovery
TAVILY_API_KEY=your_tavily_api_key

# Resume analysis and job matching
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

# Telegram is the user interface
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Optional runtime tuning
RESUME_STORAGE_DIR=storage/resumes
SEARCH_RESULTS_PER_QUERY=5
SCHEDULER_POLL_SECONDS=30
